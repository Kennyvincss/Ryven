# ═══════════════════════════════════════════════════════════════════════════
#  RYVEN: environment configuration
#  Copy this file to `.env` (cp .env.example .env) and fill in the values.
#  Variables starting with NEXT_PUBLIC_ are visible in the browser: NEVER put
#  secrets in them. Everything else stays on the server.
#  Full walkthrough: docs/SETUP.md
# ═══════════════════════════════════════════════════════════════════════════

# ── Database (required) ────────────────────────────────────────────────────
# Local Postgres:  postgres://USER:PASSWORD@localhost:5432/ryven
# Supabase:        Project → Settings → Database → Connection string (URI)
DATABASE_URL=postgres://ryven:ryven@localhost:5432/ryven

# ── Solana (required) ──────────────────────────────────────────────────────
NEXT_PUBLIC_SOLANA_CLUSTER=devnet
# Browser RPC. The public endpoint works but is rate-limited; a free Helius /
# QuickNode devnet URL is more reliable for demos.
NEXT_PUBLIC_SOLANA_RPC_URL=https://api.devnet.solana.com
# Optional separate server-side RPC (can include a private API key).
SOLANA_RPC_URL=

# Payment asset. Default = Circle's official devnet USDC (get some at
# https://faucet.circle.com → Solana Devnet). Or create your own labelled
# Test-USDC mint with `npm run test-usdc` and paste its address here.
NEXT_PUBLIC_USDC_MINT=4zMMC9srt5Ri5X14GAgXhaHii3GnPAEERYPJgZJDncDU

# ── Server secrets (required): generate all three with `npm run keys` ──────
# Signs login sessions (random, ≥32 chars).
SESSION_SECRET=
# Encrypts agent signing keys at rest (32 random bytes, base64).
# If you lose or change it, existing agents can no longer sign.
AGENT_KEY_ENCRYPTION_KEY=
# Platform fee-payer wallet (base58 secret key). Pays SOL network fees for
# agent payments. Fund its public address at https://faucet.solana.com.
FEE_PAYER_SECRET_KEY=

# ── AI (required for the agent terminal) ───────────────────────────────────
# https://console.anthropic.com → API Keys
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-5-5

# ── Admin (optional) ───────────────────────────────────────────────────────
# Comma-separated wallet addresses that may open /admin.
ADMIN_WALLETS=

# ── App URL (required in production) ───────────────────────────────────────
# Used to build metadata URLs when IPFS is not configured.
NEXT_PUBLIC_APP_URL=http://localhost:3000

# ── IPFS metadata (optional) ───────────────────────────────────────────────
# https://app.pinata.cloud → API Keys → New Key → copy the JWT.
# Without it, token images/metadata are stored in Postgres and served by Ryven.
PINATA_JWT=
PINATA_GATEWAY=https://gateway.pinata.cloud

# ── Test-USDC faucet (optional; only with your own test mint) ──────────────
TEST_USDC_FAUCET_ENABLED=false
TEST_USDC_MINT_AUTHORITY_SECRET_KEY=

# ── Bonding curve (optional; requires deploying onchain/ryven-curve) ───────
NEXT_PUBLIC_CURVE_PROGRAM_ID=
