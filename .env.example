# ═══════════════════════════════════════════════════════════════════════════
#  RYVEN: environment configuration (Solana MAINNET: real SOL and USDC)
#  Copy this file to `.env` (cp .env.example .env) and fill in the values.
#  Variables starting with NEXT_PUBLIC_ are visible in the browser: NEVER put
#  secrets in them. Everything else stays on the server.
#  Full walkthrough: docs/SETUP.md
# ═══════════════════════════════════════════════════════════════════════════

# ── Database (required) ────────────────────────────────────────────────────
# Local Postgres:  postgres://USER:PASSWORD@localhost:5432/ryven
# Supabase:        Connect → Direct → Session pooler connection string
DATABASE_URL=postgres://ryven:ryven@localhost:5432/ryven
# In development the app updates the database tables automatically when it starts.
# Set to false to turn that off (then run `npm run db:migrate` yourself).
AUTO_MIGRATE=

# ── Solana RPC (recommended) ───────────────────────────────────────────────
# Ryven runs on Solana mainnet. The public endpoint below works but is heavily
# rate-limited. A free Helius account (https://helius.dev) gives you a much more
# reliable URL like https://mainnet.helius-rpc.com/?api-key=...
NEXT_PUBLIC_SOLANA_RPC_URL=https://api.mainnet-beta.solana.com
# Optional separate server-side RPC (can include a private API key).
SOLANA_RPC_URL=

# ── Server secrets (required): generate all three with `npm run keys` ──────
# Signs login sessions (random, ≥32 chars).
SESSION_SECRET=
# Encrypts agent signing keys at rest (32 random bytes, base64).
# If you lose or change it, existing agents can no longer sign.
AGENT_KEY_ENCRYPTION_KEY=
# Platform fee-payer wallet (base58 secret key). Pays the SOL network fees of agent
# payments (~0.000005 SOL each, plus ~0.002 SOL the first time a wallet receives a
# token). Send a little REAL SOL (e.g. 0.05) to its address (printed by npm run keys).
FEE_PAYER_SECRET_KEY=

# ── AI (required for the agent terminal) ───────────────────────────────────
# https://console.anthropic.com → API Keys (and add credit under Billing)
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-5-5

# ── Admin (optional) ───────────────────────────────────────────────────────
# Comma-separated wallet addresses that may open /admin.
ADMIN_WALLETS=

# ── App URL ────────────────────────────────────────────────────────────────
# Your public URL once deployed (e.g. https://ryven.vercel.app).
NEXT_PUBLIC_APP_URL=http://localhost:3000

# ── IPFS metadata (required to launch coins while running on localhost) ────
# Coin images/metadata must be publicly reachable on mainnet.
# https://app.pinata.cloud → API Keys → New Key → copy the JWT.
PINATA_JWT=

# ── pump.fun launches (optional) ───────────────────────────────────────────
# Adds "pump.fun" to the Launch page (coins are created through PumpPortal and
# show on pump.fun). Needs PINATA_JWT above.
PUMPFUN_ENABLED=false

# ── Bonding curve (optional; requires deploying onchain/ryven-curve) ───────
NEXT_PUBLIC_CURVE_PROGRAM_ID=

# ── Advanced (optional) ────────────────────────────────────────────────────
# Separate fee payer for agent payments; defaults to FEE_PAYER_SECRET_KEY.
MAINNET_FEE_PAYER_SECRET_KEY=
# Override the server's mainnet RPC (defaults to SOLANA_RPC_URL / the URL above).
MAINNET_RPC_URL=

# Test mode for automated tests only (scripts/e2e-devnet.ts). Leave empty.
# NEXT_PUBLIC_SOLANA_CLUSTER=devnet
# NEXT_PUBLIC_USDC_MINT=<devnet test mint from npm run test-usdc>
# TEST_USDC_FAUCET_ENABLED=true
# TEST_USDC_MINT_AUTHORITY_SECRET_KEY=
